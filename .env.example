# HuggingFace API Token
# Get your token from: https://huggingface.co/settings/tokens
#
# NOTE: Token is only required for the FIRST download.
# After models are cached locally, the token is no longer needed.
# You can run: python download_models.py to download once, then remove this file.
#
HF_TOKEN=your_huggingface_token_here
